#include <iostream>

 
//Sorting function by moving each element into the right spot
//Keeps moving each element further down array until:
// it is less than next term but greater than previous


void insertionalg(long data[], int n){

      int j = 0;
      for (int i = 1; i < n; i++){
            long temp = data[i];

            for (j = i; j > 0 && temp < data[j-1]; j--){
                  data[j] = data[j-1];
            
            }
            data[j] = temp;
            
      }
}


